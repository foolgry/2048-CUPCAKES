# Cache control headers for 2048 Cupcakes game

# HTML files - short cache time to allow updates
/*.html
  Cache-Control: public, max-age=3600

# CSS and JS files - cache with versioning
/style/*.css
  Cache-Control: public, max-age=31536000, immutable

/js/*.js
  Cache-Control: public, max-age=31536000, immutable

# Font files - long cache time
/style/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Image files - long cache time
/meta/*
  Cache-Control: public, max-age=31536000, immutable

# Favicon - short cache time
/favicon.ico
  Cache-Control: public, max-age=3600

# Root index file
/index.html
  Cache-Control: public, max-age=3600

# Games directory HTML files
/games/*/index.html
  Cache-Control: public, max-age=3600